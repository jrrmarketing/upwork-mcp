<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jrr.upwork-chrome</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9222</string>
    <string>--user-data-dir=/Users/josiah/.upwork-mcp/chrome-profile</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
    <string>--window-size=1,1</string>
    <string>--window-position=9999,9999</string>
    <string>about:blank</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/josiah/.upwork-mcp/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josiah/.upwork-mcp/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/josiah</string>
  </dict>
</dict>
</plist>
